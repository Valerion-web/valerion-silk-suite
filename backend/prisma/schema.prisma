generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  CUSTOMER
  OWNER
  MANAGER
  SUPPORT
  MARKETING
  ADMIN
}

enum OrderStatus {
  PLACED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  EXCHANGE_IN_PROGRESS
}

enum StockMovementType {
  PURCHASE_IN
  SALE
  RETURN_RESTOCK
  DAMAGE
  MANUAL_ADJUSTMENT
}

enum CouponDiscountType {
  PERCENTAGE
  FLAT
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  EXCHANGE_INITIATED
  COMPLETED
}

model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique
  name          String?
  password      String
  role          UserRole   @default(CUSTOMER)
  loyaltyTier   String?
  lastOrderAt   DateTime?
  orders            Order[]
  addresses         Address[]
  auditLogs         AuditLog[] @relation("ActorAuditLogs")
  stockMovements    StockMovement[]
  statusChanges     OrderStatusHistory[]
  couponUsages      CouponUsage[]
  processedReturns  ReturnRequest[]
  productReviews    ProductReview[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Address {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  label       String
  line1       String
  line2       String?
  city        String
  state       String
  postalCode  String
  country     String
  phone       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Brand {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  logo        String?
  status      String   @default("ACTIVE")
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id               Int              @id @default(autoincrement())
  name             String
  slug             String           @unique
  sku              String?
  shortDescription String?
  fullDescription  String?
  description      String?
  brand            Brand?           @relation(fields: [brandId], references: [id])
  brandId          Int?
  price            Float
  discountPercent  Float            @default(0)
  tax              Float            @default(0)
  lowStockAlert    Int              @default(5)
  collection       String?
  tags             String?
  material         String?
  metaTitle        String?
  metaDescription  String?
  keywords         String?
  status           String           @default("ACTIVE")
  category         Category?        @relation(fields: [categoryId], references: [id])
  categoryId       Int?
  images           ProductImage[]
  variants         ProductVariant[]
  reviews          ProductReview[]
  stockMovements   StockMovement[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProductImage {
  id         Int      @id @default(autoincrement())
  product    Product  @relation(fields: [productId], references: [id])
  productId  Int
  url        String
  altText    String?
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
}

model ProductVariant {
  id               Int              @id @default(autoincrement())
  product          Product          @relation(fields: [productId], references: [id])
  productId        Int
  sku              String           @unique
  size             String?
  color            String?
  priceOverride    Float?
  quantityOnHand   Int              @default(0)
  reorderThreshold Int              @default(5)
  status           String           @default("ACTIVE")
  orderItems       OrderItem[]
  stockMovements   StockMovement[]
  exchangeReturns  ReturnRequest[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([productId])
  @@index([sku])
}

model StockMovement {
  id            Int              @id @default(autoincrement())
  variant       ProductVariant?  @relation(fields: [variantId], references: [id])
  variantId     Int?
  product       Product          @relation(fields: [productId], references: [id])
  productId     Int
  warehouseId   Int?
  changeQty     Int              @map("change")
  mode          String?
  reason        String?
  referenceId   String?          @map("reference")
  adminUser     User?            @relation(fields: [adminUserId], references: [id])
  adminUserId   Int?             @map("adminId")
  type          StockMovementType?
  createdAt     DateTime         @default(now())

  @@index([variantId])
  @@index([productId])
  @@index([adminUserId])
  @@map("StockHistory")
}

model Order {
  id             Int                  @id @default(autoincrement())
  user           User                 @relation(fields: [userId], references: [id])
  userId         Int
  status         OrderStatus          @default(PLACED)
  totalPrice     Float
  currency       String               @default("INR")
  courier        String?
  trackingNumber String?
  items          OrderItem[]
  payments       Payment[]
  statusHistory  OrderStatusHistory[]
  returnRequests ReturnRequest[]
  couponUsages   CouponUsage[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id             Int             @id @default(autoincrement())
  order          Order           @relation(fields: [orderId], references: [id])
  orderId        Int
  variant        ProductVariant  @relation(fields: [variantId], references: [id])
  variantId      Int
  quantity       Int             @default(1)
  unitPrice      Float
  taxAmount      Float           @default(0)
  discountAmount Float           @default(0)
  returnRequests ReturnRequest[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id          Int         @id @default(autoincrement())
  order       Order       @relation(fields: [orderId], references: [id])
  orderId     Int
  status      OrderStatus
  note        String?
  changedBy   User?       @relation(fields: [changedById], references: [id])
  changedById Int?
  createdAt   DateTime    @default(now())

  @@index([orderId])
}

model Payment {
  id            Int      @id @default(autoincrement())
  order         Order    @relation(fields: [orderId], references: [id])
  orderId       Int
  amount        Float
  currency      String   @default("INR")
  method        String
  status        String
  provider      String?
  transactionId String?
  capturedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([orderId])
}

model Coupon {
  id            Int              @id @default(autoincrement())
  code          String           @unique
  discountType  CouponDiscountType
  value         Float
  active        Boolean          @default(true)
  usageLimit    Int?
  usageCount    Int              @default(0)
  minOrderValue Float?
  startsAt      DateTime?
  endsAt        DateTime?
  usages        CouponUsage[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model CouponUsage {
  id        Int      @id @default(autoincrement())
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  couponId  Int
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   Int
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([orderId])
  @@index([userId])
}

model ReturnRequest {
  id                Int                 @id @default(autoincrement())
  order             Order               @relation(fields: [orderId], references: [id])
  orderId           Int
  orderItem         OrderItem           @relation(fields: [orderItemId], references: [id])
  orderItemId       Int
  reason            String
  status            ReturnRequestStatus @default(REQUESTED)
  requestedAt       DateTime            @default(now())
  processedAt       DateTime?
  processedBy       User?               @relation(fields: [processedById], references: [id])
  processedById     Int?
  resolution        String?
  refundAmount      Float?
  exchangeVariant   ProductVariant?     @relation(fields: [exchangeVariantId], references: [id])
  exchangeVariantId Int?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([orderId])
  @@index([orderItemId])
}

model Banner {
  id         Int      @id @default(autoincrement())
  title      String
  image      String
  link       String?
  placement  String
  active     Boolean  @default(true)
  startsAt   DateTime
  endsAt     DateTime
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ProductReview {
  id          Int      @id @default(autoincrement())
  product     Product  @relation(fields: [productId], references: [id])
  productId   Int
  user        User?    @relation(fields: [userId], references: [id])
  userId      Int?
  rating      Int
  comment     String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([userId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actor       User?    @relation("ActorAuditLogs", fields: [actorId], references: [id])
  actorId     Int?
  action      String
  entity      String
  entityId    String
  field       String?
  beforeValue String?
  afterValue  String?
  metadata    String?
  createdAt   DateTime @default(now())
}
