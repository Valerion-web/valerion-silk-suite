{
  "name": "house-of-valerion-backend",
  "version": "1.0.0",
  "description": "Backend API for House of Valerion ecommerce store",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/**/*.test.mjs",
    "admin:bootstrap": "node scripts/admin-bootstrap.mjs",
    "admin:bootstrap:audit": "node scripts/admin-bootstrap-audit.mjs",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev --name init",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "7.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pg": "^8.21.0",
    "razorpay": "^2.9.8",
    "read-excel-file": "9.3.10",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prisma": "^7.8.0"
  }
}
